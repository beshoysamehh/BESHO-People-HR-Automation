    {
      "parameters": {
        "sendTo": "YOUR_SENDTO",
        "subject": "=🚨 [{{ $('Check Throttle').item.json.severity.toUpperCase() }}] {{ $('Check Throttle').item.json.workflow }} failed at \"{{ $('Check Throttle').item.json.node }}\"",
        "message": "=<div style=\"margin:0;padding:32px 12px;background:#eef1f6;font-family:'Segoe UI',Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,0.12);\">\n\n    <!-- HEADER -->\n    <tr>\n      <td style=\"background-color:#0f172a;background-image:linear-gradient(135deg,#0f172a 0%,#1e293b 60%,{{ $('Check Throttle').item.json.severity === 'critical' ? '#7f1d1d' : '#78350f' }} 100%);padding:32px 32px 28px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td>\n              <span style=\"display:inline-block;background:{{ $('Check Throttle').item.json.severity === 'critical' ? '#ef4444' : '#f59e0b' }};color:#ffffff;font-size:11px;font-weight:700;letter-spacing:1.5px;padding:6px 12px;border-radius:999px;\">\n                ● {{ $('Check Throttle').item.json.severity.toUpperCase() }}\n              </span>\n              <span style=\"display:inline-block;background:rgba(255,255,255,0.12);color:#cbd5e1;font-size:11px;font-weight:600;letter-spacing:1px;padding:6px 12px;border-radius:999px;margin-left:6px;\">\n                {{ $('Check Throttle').item.json.type.toUpperCase() }}\n              </span>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding-top:18px;\">\n              <h1 style=\"margin:0;color:#ffffff;font-size:26px;line-height:1.25;font-weight:700;\">A workflow just failed</h1>\n              <p style=\"margin:8px 0 0;color:#94a3b8;font-size:14px;line-height:1.5;\">\n                <b style=\"color:#e2e8f0;\">{{ $('Check Throttle').item.json.workflow }}</b> stopped at\n                <b style=\"color:#e2e8f0;\">{{ $('Check Throttle').item.json.node }}</b>\n              </p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- DETAILS CARDS -->\n    <tr>\n      <td style=\"padding:24px 32px 0;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td width=\"50%\" style=\"padding-right:6px;\">\n              <div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;\">\n                <div style=\"font-size:11px;color:#64748b;letter-spacing:1px;font-weight:600;\">TIME (CAIRO)</div>\n                <div style=\"font-size:15px;color:#0f172a;font-weight:600;margin-top:4px;\">{{ $('Check Throttle').item.json.time }}</div>\n              </div>\n            </td>\n            <td width=\"50%\" style=\"padding-left:6px;\">\n              <div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px 16px;\">\n                <div style=\"font-size:11px;color:#64748b;letter-spacing:1px;font-weight:600;\">EXECUTION ID</div>\n                <div style=\"font-size:15px;color:#0f172a;font-weight:600;margin-top:4px;\">#{{ $('Check Throttle').item.json.executionId }}</div>\n              </div>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- ERROR MESSAGE -->\n    <tr>\n      <td style=\"padding:24px 32px 0;\">\n        <div style=\"font-size:12px;color:#64748b;letter-spacing:1px;font-weight:700;margin-bottom:8px;\">ERROR MESSAGE</div>\n        <div style=\"background:#0f172a;border-left:4px solid {{ $('Check Throttle').item.json.severity === 'critical' ? '#ef4444' : '#f59e0b' }};border-radius:10px;padding:16px 18px;color:#fca5a5;font-family:Consolas,'Courier New',monospace;font-size:13px;line-height:1.6;white-space:pre-wrap;word-break:break-word;\">{{ $('Check Throttle').item.json.message }}</div>\n      </td>\n    </tr>\n\n    <!-- WHAT TO DO -->\n    <tr>\n      <td style=\"padding:24px 32px 0;\">\n        <div style=\"background:#ecfdf5;border:1px solid #a7f3d0;border-radius:12px;padding:18px 20px;\">\n          <div style=\"font-size:12px;color:#047857;letter-spacing:1px;font-weight:700;margin-bottom:6px;\">💡 RECOMMENDED FIX</div>\n          <div style=\"font-size:14px;color:#064e3b;line-height:1.65;\">{{ $('Check Throttle').item.json.fix }}</div>\n        </div>\n      </td>\n    </tr>\n\n    <!-- CTA -->\n    <tr>\n      <td align=\"center\" style=\"padding:30px 32px 34px;\">\n        <a href=\"{{ $('Check Throttle').item.json.executionUrl }}\" style=\"display:inline-block;background-color:#2563eb;background-image:linear-gradient(135deg,#2563eb,#4f46e5);color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;padding:14px 34px;border-radius:10px;\">\n          Open execution →\n        </a>\n      </td>\n    </tr>\n\n    <!-- FOOTER -->\n    <tr>\n      <td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 32px;text-align:center;\">\n        <p style=\"margin:0;font-size:12px;color:#94a3b8;line-height:1.6;\">\n          Repeats of this same problem are suppressed for 1 hour.<br>\n          Warnings are collected in the daily digest.\n        </p>\n      </td>\n    </tr>\n  </table>\n</div>",
        "options": {}
      },
